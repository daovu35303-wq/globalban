# Optional advisory proxy. Leave empty to keep AI requests disabled.
# The endpoint must be HTTPS and must be an explicitly approved privacy proxy.
GLOBALBAN_PROXY_URL=

# Optional WhatsApp notifications. The notifier sends only a masked alert after
# an explicit send_alert(alert) call; these values are never read automatically
# from a .env file.
GLOBALBAN_TWILIO_ACCOUNT_SID=
GLOBALBAN_TWILIO_AUTH_TOKEN=
GLOBALBAN_WHATSAPP_FROM=whatsapp:+14155238886
GLOBALBAN_WHATSAPP_TO=

# Optional privacy-proxy server. The server refuses to start without a strong
# client token, upstream API key, and TLS certificate/key. Never commit actual
# values. Only fixed HTTPS provider hosts are accepted by the server.
GLOBALBAN_PROXY_CLIENT_TOKEN=
GLOBALBAN_AI_API_KEY=
GLOBALBAN_PROXY_BIND=127.0.0.1
GLOBALBAN_PROXY_PORT=8443
GLOBALBAN_PROXY_UPSTREAM=https://api.openai.com/v1
GLOBALBAN_PROXY_MODEL=gpt-4o-mini
GLOBALBAN_PROXY_TLS_CERT=
GLOBALBAN_PROXY_TLS_KEY=

# Optional remote threat-intelligence lookup. The lookup client remains disabled
# unless enabled in trusted application code and the caller passes approved=True.
# Sending an indicator discloses that exact IP to this explicitly trusted host.
GLOBALBAN_TI_ENDPOINT=
GLOBALBAN_TI_ALLOWED_HOST=
GLOBALBAN_TI_API_KEY=
GLOBALBAN_TI_ENABLED=false